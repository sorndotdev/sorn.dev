---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

export interface Props {
  title: string;
  description?: string;
  prose?: boolean;
  ogImage?: string;
}

const { title, description, prose } = Astro.props.frontmatter ?? Astro.props;
const ogImage = new URL(Astro.props.frontmatter?.ogImage ?? Astro.props.ogImage ?? "/images/og-default.png", "https://sorn.dev").href;
const pageUrl = new URL(Astro.url.pathname, "https://sorn.dev").href;
const rawDate = (Astro.props.frontmatter ?? Astro.props).date;
const publishedDate = (rawDate instanceof Date ? rawDate.toISOString() : String(rawDate ?? "2026-08-15")).slice(0, 10);
const articleJson = prose
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description: description ?? title,
      datePublished: publishedDate,
      dateModified: publishedDate,
      mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
      author: { "@type": "Person", "name": "Sorn Maksumic", "url": "https://sorn.dev" },
      publisher: { "@type": "Organization", "name": "Sorn.dev", "url": "https://sorn.dev" }
    })
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Sorn.dev</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={`${title} — Sorn.dev`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Sorn Maksumic",
      "givenName": "Sorn",
      "familyName": "Maksumic",
      "jobTitle": "Fintech Software Engineer",
      "description": "Building high-quality software at the intersection of finance and technology. Java, distributed systems, and domain-driven design.",
      "url": "https://www.sorn.dev",
      "email": "maksumic@protonmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Dubai",
        "addressCountry": "United Arab Emirates"
      },
      "sameAs": [
        "https://github.com/sorndotdev",
        "https://linkedin.com/in/sorndotdev"
      ],
      "knowsAbout": [
        "Java",
        "JVM",
        "Distributed Systems",
        "TDD",
        "DDD",
        "CQRS",
        "Event Sourcing",
        "Kafka",
        "RabbitMQ",
        "PostgreSQL",
        "Foreign Exchange",
        "Multi-Currency Ledgers",
        "Dividend Investing",
        "Microservices",
        "Kubernetes",
        "GCP",
        "REST API Design",
        "Fintech",
        "Accounting",
        "Fundamental Analysis",
        "Scrum"
      ],
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "University of South Eastern Norway",
        "sameAs": "https://www.usn.no"
      },
      "award": "Best Bachelor Project 2021",
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "name": "Professional Scrum Master I",
        "url": "https://www.credly.com/badges/acdabbf8-9bed-44b6-89c1-eb93bf718c47/public_url",
        "issuedBy": {
          "@type": "Organization",
          "name": "Scrum.org"
        }
      },
      "worksFor": [
        {
          "@type": "Organization",
          "name": "Revolut",
          "description": "Software Engineer, Wealth & Trading Team",
          "location": "Dubai, United Arab Emirates"
        },
        {
          "@type": "Organization",
          "name": "Adyen",
          "description": "Team Lead, Foreign Exchange Team",
          "location": "Amsterdam, Netherlands"
        },
        {
          "@type": "Organization",
          "name": "Snapstock",
          "description": "Founding Engineer — Dividend stock analysis platform"
        }
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Sorn.dev",
      "url": "https://sorn.dev",
      "description": "Fintech Systems Engineer",
      "inLanguage": "en",
      "author": {
        "@type": "Person",
        "name": "Sorn Maksumic",
        "url": "https://sorn.dev"
      }
    }
    </script>
    {articleJson && <script type="application/ld+json" set:html={articleJson} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-navy-950 text-slate-700 antialiased min-h-screen flex flex-col">
    <!-- Nav -->
    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur-xl">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <span class="text-lg font-bold gradient-text group-hover:opacity-80 transition-opacity">Sorn.dev</span>
          <span class="hidden sm:inline text-sm text-slate-500">Fintech Systems Engineer</span>
        </a>
        <div class="flex items-center gap-4 sm:gap-8 text-xs sm:text-sm">
          <a href="/" class="text-slate-600 hover:text-slate-900 transition-colors whitespace-nowrap">About</a>
          <a href="/articles" class="text-slate-600 hover:text-slate-900 transition-colors whitespace-nowrap">Articles</a>
          <a href="/projects" class="text-slate-600 hover:text-slate-900 transition-colors whitespace-nowrap">Projects</a>
        </div>
      </nav>
    </header>

    <!-- Main -->
    <main class="flex-1">
      <div class={prose ? "prose-custom max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12" : ""}>
        <slot />
        {prose && (
          <>
            <div class="article-author">
              <img src="/images/blog/me.png" alt="Sorn" />
              <div>
                <p class="article-author-name">Sorn.dev</p>
                <p>I read everything. Email is on the <a href="/">about page</a>.</p>
              </div>
            </div>
            <p class="article-author-copyright">Republishing or redistribution requires written permission.</p>
          </>
        )}
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between text-sm text-slate-500">
        <span>&copy; 2026 Sorn.dev</span>
        <div class="flex items-center gap-5">
          <a href="https://x.com/sorndotdev" target="_blank" rel="noopener noreferrer" class="hover:text-slate-700 transition-colors" aria-label="X">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://github.com/sorndotdev" target="_blank" rel="noopener noreferrer" class="hover:text-slate-700 transition-colors" aria-label="GitHub">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a href="https://linkedin.com/in/sorndotdev" target="_blank" rel="noopener noreferrer" class="hover:text-slate-700 transition-colors" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  .prose-custom h1, .prose-custom h2, .prose-custom h3 {
    color: #0f172a;
  }
  .prose-custom h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .prose-custom h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-custom h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .prose-custom p, .prose-custom li {
    color: #475569;
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .prose-custom ol, .prose-custom ul {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .prose-custom ol {
    list-style: decimal;
  }
  .prose-custom ol li {
    padding-left: 1.25rem;
  }
  .prose-custom ul {
    list-style: disc;
  }
  .prose-custom li {
    margin-bottom: 0.5rem;
  }
  .prose-custom a {
    color: #4f46e5;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-custom a:hover {
    color: #4338ca;
  }
  .prose-custom code {
    color: #047857;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875em;
  }
  .prose-custom pre {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 0.75rem;
    padding: 1.25rem;
    overflow-x: auto;
  }
  .prose-custom pre code {
    color: #e2e8f0;
    font-size: 0.8125rem;
  }
  .prose-custom blockquote {
    border-left: 3px solid #6366f1;
    padding-left: 1.25rem;
    color: #64748b;
    font-style: italic;
    margin: 1.5rem 0;
  }
  .prose-custom blockquote p {
    margin-bottom: 0.5rem;
  }
  .prose-custom blockquote p:last-child {
    margin-bottom: 0;
  }
  .prose-custom blockquote strong {
    color: #4f46e5;
    font-weight: 700;
    font-style: normal;
  }
  .prose-custom img {
    border-radius: 0.75rem;
    border: 1px solid #e2e8f0;
    width: auto;
    max-width: 100%;
    height: auto;
  }
  .prose-custom hr {
    border-color: #e2e8f0;
    margin: 2rem 0;
  }
  .prose-custom table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }
  .prose-custom th {
    color: #0f172a;
    font-weight: 600;
    padding: 0.75rem;
    border-bottom: 1px solid #cbd5e1;
  }
  .prose-custom tr:not([align]) th:not([align]) {
    text-align: left;
  }
  .prose-custom td {
    padding: 0.75rem;
    border-bottom: 1px solid #eef2f7;
  }
  .prose-custom table.ledger {
    width: auto;
    margin: 1.75rem 0 1.25rem;
  }
  @media (max-width: 640px) {
    .prose-custom table {
      display: block;
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .prose-custom table.ledger {
      width: 100%;
    }
  }
  .prose-custom table.ledger th,
  .prose-custom table.ledger td {
    padding: 0.25rem 0.5rem;
  }
  .article-author {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;
  }
  .article-author img {
    width: 90px;
    height: 90px;
    border-radius: 9999px;
    object-fit: cover;
    border: 1px solid #e2e8f0;
    flex-shrink: 0;
  }
  .article-author p {
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }
  .article-author .article-author-name {
    color: #0f172a;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .article-author-copyright {
    color: #94a3b8;
    font-size: 0.875rem;
    margin-top: 2.5rem;
    margin-bottom: 0;
  }
</style>
