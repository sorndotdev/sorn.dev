---
// Print-optimized resume. Linked from the "Export resume" button in the nav.
// The browser's native "Save as PDF" does the PDF generation: vector text,
// selectable content, correct fonts, zero client-side libraries.
import { contact, credentials, education, email, experience, profile } from '../data/resume';
import Icon from '../components/Icon.astro';

const autoPrint = Astro.url.searchParams.get('print') === '1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{profile.name} — Resume</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --ink: #0f172a;
        --body: #334155;
        --muted: #64748b;
        --hairline: #d8dee9;
        --accent: #4338ca;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--body);
        font-size: 10.5pt;
        line-height: 1.45;
        background: linear-gradient(180deg, #e2e8f0 0%, #cbd5e1 100%);
        background-attachment: fixed;
      }

      /* Screen-only chrome */
      .chrome {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(203, 213, 225, 0.7);
      }
      .chrome-inner {
        max-width: 900px;
        margin: 0 auto;
        height: 56px;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .chrome a { color: var(--body); text-decoration: none; font-size: 13px; font-weight: 500; }
      .chrome a:hover { color: var(--ink); }
      .chrome .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #1d4ed8, #4f46e5);
        color: #fff;
        border: none;
        border-radius: 9999px;
        padding: 8px 18px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
      }
      .chrome .btn:hover { opacity: 0.9; }

      /* Printable sheet */
      .sheet {
        max-width: 900px;
        margin: 32px auto 64px;
        background: #fff;
        padding: 52px 56px;
        border-radius: 8px;
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12);
      }

      h1 {
        font-size: 23pt;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -0.01em;
      }
      .role-line {
        font-size: 11.5pt;
        font-weight: 600;
        color: var(--accent);
        margin-top: 3px;
      }
      .contact-line {
        margin-top: 10px;
        font-size: 9.5pt;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        column-gap: 14px;
        row-gap: 2px;
      }
      .contact-line a { color: inherit; text-decoration: none; }
      .contact-line .sep { color: #94a3b8; }

      section { margin-top: 20px; }
      h2 {
        font-size: 10pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--ink);
        border-bottom: 1.5px solid var(--ink);
        padding-bottom: 4px;
        margin-bottom: 10px;
        break-after: avoid;
      }
      .summary { color: var(--body); }
      .summary + .summary { margin-top: 4px; }

      .entry { margin-bottom: 12px; break-inside: avoid; }
      .entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
      .entry-head h3 { font-size: 11pt; font-weight: 700; color: var(--ink); }
      .entry-head h3 span { color: var(--body); }
      .entry-head .period {
        font-size: 9pt;
        color: var(--muted);
        white-space: nowrap;
      }
      .entry .sub { font-size: 10pt; color: var(--body); font-weight: 500; margin-top: 1px; }
      .entry .loc { font-size: 9.5pt; color: var(--muted); margin-top: 1px; }
      .entry .desc { margin-top: 5px; }
      .skills {
        margin-top: 5px;
        display: flex;
        flex-wrap: wrap;
        gap: 4px 6px;
      }
      .skills span {
        font-size: 8.5pt;
        color: var(--body);
        border: 0.5pt solid #cbd5e1;
        border-radius: 3px;
        padding: 1px 6px;
        white-space: nowrap;
      }
      .cred { margin-top: 5px; font-size: 9.5pt; }
      .cred a { color: var(--body); text-decoration: none; }

      .edu .entry-head h3 { font-size: 11pt; }
      .edu-award { margin-top: 3px; font-size: 9.5pt; }
      .edu-award a { color: var(--body); text-decoration: none; }

      .two-col { display: flex; flex-wrap: wrap; gap: 24px; }
      .two-col > div { flex: 1 1 240px; }

      .hint { text-align: center; color: #64748b; font-size: 12px; padding: 0 20px 48px; }

      @media print {
        body { background: #fff !important; }
        .chrome, .hint { display: none !important; }
        .sheet { max-width: none; margin: 0; padding: 0; box-shadow: none; border-radius: 0; }
        section { break-inside: auto; }
        a { color: inherit; text-decoration: none; }
      }
      @page { size: A4; margin: 12mm 13mm 14mm; }
    </style>
  </head>
  <body>
    <div class="chrome">
      <div class="chrome-inner">
        <a href="/">&larr; sorn.dev</a>
        <button class="btn" id="print-btn" type="button">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Print / Save as PDF
        </button>
      </div>
    </div>

    <div class="sheet">
      <header>
        <h1>{profile.name}</h1>
        <div class="role-line">{profile.title}</div>
        <div class="contact-line">
          <span>{profile.location}</span>
          <span class="sep">|</span>
          <a href={`mailto:${email}`}>{email}</a>
          <span class="sep">|</span>
          <a href={contact.githubUrl}>{contact.githubUrl.replace('https://', '')}</a>
          <span class="sep">|</span>
          <a href={contact.website}>{contact.website.replace('https://', '')}</a>
        </div>
      </header>

      <section>
        <h2>Profile</h2>
        <p class="summary">{profile.bio}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {experience.map(e => (
          <div class="entry">
            <div class="entry-head">
              <h3>
                {e.role}
                {e.company && <span> &mdash; {e.company}</span>}
                {e.promoted && <span> (Promoted)</span>}
              </h3>
              <span class="period">{e.period}</span>
            </div>
            <p class="loc">{e.location}</p>
            <p class="desc">{e.description}</p>
            <div class="skills">
              {e.skills.map(s => <span>{s}</span>)}
            </div>
            {e.credential && (
              <p class="cred"><a href={e.credential.href}>{e.credential.label}</a></p>
            )}
          </div>
        ))}
      </section>

      <section class="edu">
        <h2>Education</h2>
        <div class="entry">
          <div class="entry-head">
            <h3>{education.school}</h3>
            <span class="period">{education.period}</span>
          </div>
          <p class="sub">{education.degree}</p>
          <p class="loc">{education.location}</p>
          {education.role && <p class="sub">{education.role}</p>}
          <p class="edu-award"><a href={education.awardHref}>{education.awardLabel}</a></p>
        </div>
      </section>

      <section>
        <h2>Credentials</h2>
        <div class="entry">
          <div class="skills">
            {credentials.map(c => <span>{c.label}</span>)}
          </div>
        </div>
      </section>

      <section>
        <h2>Projects</h2>
        <div class="entry">
          <p class="cred"><a href="https://sorn.dev/projects">sorn.dev/projects</a></p>
        </div>
      </section>

    </div>

    <p class="hint">Tip: in the print dialog, choose "Save as PDF" as the destination.</p>

    <script>
      const params = new URLSearchParams(window.location.search);
      const printBtn = document.getElementById('print-btn');
      if (printBtn) printBtn.addEventListener('click', () => window.print());

      // Auto-open the print dialog when arriving via the "Export resume" nav button.
      if (params.get('print') === '1') {
        const doPrint = () => window.print();
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(doPrint).catch(() => setTimeout(doPrint, 500));
        } else {
          setTimeout(doPrint, 500);
        }
      }
    </script>
  </body>
</html>
