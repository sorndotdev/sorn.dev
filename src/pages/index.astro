---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { credentials, education, experience, profile } from '../data/resume';
---

<BaseLayout title="Sorn Maksumic — Fintech Software Engineer" description="Sorn's personal website about high-quality software engineering. Java fintech engineer. Adyen, Revolut, Snapstock.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-2">About</h1>
    <p class="text-slate-500 mb-10">{profile.summary}</p>

    <!-- Bio card -->
    <section class="mb-16">
      <div class="glass-card rounded-2xl p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
          <div>
            <h2 class="text-xl font-semibold text-slate-900">{profile.name}</h2>
            <p class="text-slate-600">{profile.location}</p>
          </div>
          <div class="flex gap-4 items-center">
            <a href="https://github.com/sorndotdev" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-indigo-600 transition-colors text-sm font-medium">
              GitHub ↗
            </a>
            <a href="#" id="email-link" class="text-slate-500 hover:text-indigo-600 transition-colors text-sm font-medium">
              Email
            </a>
          </div>
        </div>
        <p class="text-slate-600 leading-relaxed">
          {profile.bio}
        </p>
        <div class="mt-5 pt-4 border-t border-slate-200">
          <p class="text-sm text-slate-600">
            Open to senior/staff engineering opportunities
            <span class="text-slate-400">→</span>
            <a href="#" id="email-cta" class="font-medium text-indigo-600 hover:text-indigo-500 transition-colors">
              Email me
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-16">
      <h2 class="text-xs font-semibold text-slate-600 uppercase tracking-[0.2em] mb-6">Professional Experience</h2>
      <div class="space-y-4">
        {experience.map(e => (
          <div class="glass-card rounded-xl p-5 sm:p-6">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-3">
              <div class="flex items-center gap-3">
                {e.logo && <img src={e.logo} alt={e.company} class="h-5 opacity-60 shrink-0" />}
                <div>
                  <h3 class="text-slate-900 font-semibold">
                    {e.company}
                    {e.promoted && <span class="text-xs text-emerald-500 font-normal"> ▲ Promoted</span>}
                  </h3>
                  <p class="text-slate-600 text-sm">{e.role}</p>
                </div>
              </div>
              <span class="text-xs text-slate-600 whitespace-nowrap">{e.period}</span>
            </div>
            <p class="text-slate-500 text-sm mb-3">{e.location}</p>
            <p class="text-slate-500 text-sm leading-relaxed mb-3">
              {e.description}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {e.skills.map(s => <span class="px-2 py-0.5 bg-slate-100 border border-slate-200 text-slate-600 text-xs rounded">{s}</span>)}
            </div>
            {e.credential && (
              <div class="mt-3">
                <a href={e.credential.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-slate-500 hover:text-indigo-600 transition-colors">
                  <Icon name="shield" size={14} />
                  {e.credential.label}
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="mb-16">
      <h2 class="text-xs font-semibold text-slate-600 uppercase tracking-[0.2em] mb-6">Education</h2>
      <div class="glass-card rounded-xl p-5 sm:p-6">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-2">
          <div>
            <h3 class="text-slate-900 font-semibold">{education.school}</h3>
            <p class="text-slate-600 text-sm">{education.degree}</p>
          </div>
          <span class="text-xs text-slate-600 whitespace-nowrap">{education.period}</span>
        </div>
        <p class="text-slate-500 text-sm mb-3">{education.location}</p>
        <a href={education.awardHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-slate-500 hover:text-indigo-600 transition-colors">
          <Icon name="shield" size={14} />
          {education.awardLabel}
        </a>
      </div>
    </section>

    <!-- Credentials -->
    <section>
      <h2 class="text-xs font-semibold text-slate-600 uppercase tracking-[0.2em] mb-6">Credentials</h2>
      <div class="flex flex-wrap gap-3">
        {credentials.map(c => (
          <a href={c.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 glass-card rounded-lg text-sm text-slate-600 hover:text-slate-900 transition-colors">
            <Icon name={c.icon} size={16} />
            {c.label}
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Email obfuscated from source to avoid spam harvesters
  (function() {
    const user = 'maksumic';
    const domain = 'protonmail.com';
    const subject = 'Opportunity from sorn.dev';
    const href = `mailto:${user}@${domain}?subject=${encodeURIComponent(subject)}`;

    const link = document.getElementById('email-link');
    if (link) {
      link.href = href;
      link.textContent = `${user}@${domain}`;
    }

    const cta = document.getElementById('email-cta');
    if (cta) cta.href = href;
  })();
</script>
