---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Articles" description="Articles and long-form posts by Sorn Maksumic on software engineering, fintech, and more.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl sm:text-4xl font-bold text-white mb-2">Articles</h1>
    <p class="text-slate-500 mb-10">Original long-form thoughts on software engineering, fintech, and building things.</p>

    <div class="space-y-6">
      <!-- How Global Fintechs Use Double-Entry Bookkeeping -->
      <a href="/articles/how-global-fintechs-use-double-entry-bookkeeping" class="block glass-card rounded-2xl p-6 sm:p-8 group transition-all">
        <div class="flex items-start justify-between gap-4 mb-3">
          <h2 class="text-xl font-semibold text-white group-hover:text-indigo-400 transition-colors">
            How Global Fintechs Use Double-Entry Bookkeeping
          </h2>
          <span class="shrink-0 text-sm text-slate-600 whitespace-nowrap">2026-08-14</span>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed mb-4">
          You don't need a payment status column if your ledger is designed correctly. Every payment is just debits and credits—at internet scale.
        </p>
        <div class="flex items-center gap-2 text-xs text-slate-600">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span>Read on Sorn.dev</span>
        </div>
      </a>
    </div>
  </div>
</BaseLayout>
